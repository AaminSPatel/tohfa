# Copy this file to .env.local and fill it in. Never commit .env.local.

# Public URL of the site (canonical URLs, sitemap, Open Graph, links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- MongoDB (orders, inquiries, admin panel) ----
MONGODB_URI=

# ---- Admin login ----
# Secret that signs admin session cookies. Generate: openssl rand -base64 48  (min 32 chars)
AUTH_SECRET=
# One-time code required on /admin/signup. Delete it after creating your admin account.
ADMIN_SIGNUP_CODE=

# ---- Email (Nodemailer / SMTP) ----
# Gmail example: host smtp.gmail.com, port 465, user = your gmail, pass = an App Password
# (Google Account > Security > 2-Step Verification > App passwords). Not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Shown as the sender. Must be your SMTP_USER address (or one your provider allows).
MAIL_FROM="Tohfa <you@example.com>"
# Where order / inquiry / problem alerts go. Separate several addresses with commas.
ADMIN_NOTIFY_EMAIL=

# ---- Cloudinary (product photo uploads) ----
# Cloudinary dashboard > Settings > API Keys. Use these three...
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ...or the single CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name> instead.
